@page
@model Frontend.Pages.InicializarModel
@{
    ViewData["Title"] = "Reiniciar datos";
}

<partial name="_Alerta" model="Model.Respuesta" />
<p class="aviso">Esta operación borrará todos los contribuyentes y las facturas guardadas en el backend. No se puede deshacer.</p>
<form method="post" class="formulario" onsubmit="return confirm('¿Seguro que deseas borrar todos los contribuyentes y las facturas?');">
    <button class="boton boton-peligro" type="submit">Borrar todos los datos</button>
</form>
