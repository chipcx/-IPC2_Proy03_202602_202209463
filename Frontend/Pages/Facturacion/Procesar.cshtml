@page
@model Frontend.Pages.Facturacion.ProcesarModel
@{
    ViewData["Title"] = "Procesar facturas";
}

<partial name="_Alerta" model="Model.Respuesta" />
<p class="texto-ayuda">Selecciona un archivo JSON de facturas de tu computadora. Cada factura debe incluir TIEMPO, REFERENCIA, NIT_EMISOR, NIT_RECEPTOR, VALOR, IVA y TOTAL; los contribuyentes deben estar registrados previamente.</p>
<form method="post" enctype="multipart/form-data" class="formulario">
    <div class="campo">
        <label asp-for="Archivo">Archivo JSON de facturas</label>
        <input asp-for="Archivo" type="file" accept=".json,application/json" />
    </div>
    <button class="boton" type="submit">Procesar lote</button>
</form>
<p class="acciones"><a asp-page="/Facturacion/Procesadas">Ver todas las facturas procesadas</a></p>
